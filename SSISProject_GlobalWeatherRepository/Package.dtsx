        <DTS:Executable
          DTS:refId="Package\SEQ_Build_DW\Create_DIM_FACT_Table"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{BA2B95F6-E4CE-49A5-B17E-A02952845D5D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Create_DIM_FACT_Table"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{4DB79DBB-F5AD-4648-893F-5AA4E72DF8B6}"
              SQLTask:SqlStatementSource="-- DIM_COUNTRY&#xA;CREATE TABLE DIM_COUNTRY (&#xA;    country_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    country VARCHAR(100) NOT NULL&#xA;);&#xA;&#xA;-- DIM_LOCATION&#xA;CREATE TABLE DIM_LOCATION (&#xA;    location_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    country_id INT NOT NULL,&#xA;    location_name VARCHAR(150) NOT NULL,&#xA;    latitude FLOAT,&#xA;    longitude FLOAT,&#xA;    timezone VARCHAR(100)&#xA;);&#xA;&#xA;-- DIM_DATE&#xA;CREATE TABLE DIM_DATE (&#xA;    date_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    last_updated_epoch INT,&#xA;    last_updated DATETIME,&#xA;    full_date DATE,&#xA;    year INT,&#xA;    month INT,&#xA;    day INT,&#xA;    hour INT,&#xA;    minute INT,&#xA;    day_of_week VARCHAR(20)&#xA;);&#xA;&#xA;-- DIM_CONDITION&#xA;CREATE TABLE DIM_CONDITION (&#xA;    condition_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    condition_text VARCHAR(150) NOT NULL&#xA;);&#xA;&#xA;-- DIM_AIR_QUALITY&#xA;CREATE TABLE DIM_AIR_QUALITY (&#xA;    air_quality_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    air_quality_pm2_5 FLOAT,&#xA;    air_quality_pm10 FLOAT,&#xA;    air_quality_us_epa_index INT,&#xA;    air_quality_gb_defra_index INT&#xA;);&#xA;&#xA;-- DIM_WIND_DIRECTION&#xA;CREATE TABLE DIM_WIND_DIRECTION (&#xA;    wind_direction_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    wind_degree INT,&#xA;    wind_direction VARCHAR(20)&#xA;);&#xA;&#xA;-- DIM_MOON_PHASE&#xA;CREATE TABLE DIM_MOON_PHASE (&#xA;    moon_phase_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    moon_phase VARCHAR(50) NOT NULL&#xA;);&#xA;&#xA;-- DIM_ASTRONOMY&#xA;CREATE TABLE DIM_ASTRONOMY (&#xA;    astronomy_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    moon_phase_id INT NOT NULL,&#xA;    sunrise TIME,&#xA;    sunset TIME&#xA;);&#xA;&#xA;-- FACT_WEATHER&#xA;CREATE TABLE FACT_WEATHER (&#xA;    weather_id INT IDENTITY(1,1) PRIMARY KEY,&#xA;    location_id INT NOT NULL,&#xA;    date_id INT NOT NULL,&#xA;    condition_id INT NOT NULL,&#xA;    air_quality_id INT NOT NULL,&#xA;    wind_direction_id INT NOT NULL,&#xA;    astronomy_id INT NOT NULL,&#xA;    temperature_celsius FLOAT,&#xA;    feels_like_celsius FLOAT,&#xA;    humidity INT,&#xA;    pressure_mb FLOAT,&#xA;    precip_mm FLOAT,&#xA;    wind_kph FLOAT,&#xA;    cloud INT,&#xA;    visibility_km FLOAT,&#xA;    uv_index FLOAT,&#xA;    moon_illumination INT&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>

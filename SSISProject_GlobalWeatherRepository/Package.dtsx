        <SQLTask:SqlTaskData
          SQLTask:Connection="{E0D815ED-7D7D-44C8-87AE-9B0F7F5F88A6}"
          SQLTask:SqlStatementSource="DROP TABLE IF EXISTS dbo.FACT_WEATHER;&#xA;&#xA;DROP TABLE IF EXISTS dbo.DIM_ASTRONOMY;&#xA;DROP TABLE IF EXISTS dbo.DIM_MOON_PHASE;&#xA;DROP TABLE IF EXISTS dbo.DIM_WIND_DIRECTION;&#xA;DROP TABLE IF EXISTS dbo.DIM_WEATHER_CONDITION;&#xA;DROP TABLE IF EXISTS dbo.DIM_TIME;&#xA;DROP TABLE IF EXISTS dbo.DIM_DATE;&#xA;DROP TABLE IF EXISTS dbo.DIM_LOCATION;&#xA;DROP TABLE IF EXISTS dbo.DIM_COUNTRY;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

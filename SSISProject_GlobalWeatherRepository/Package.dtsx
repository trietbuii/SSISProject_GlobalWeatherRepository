    <DTS:Executable
      DTS:refId="Package\Create All Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C0EFD0CF-509C-48EB-B74A-6F9EA94A7337}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create All Tables"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E0D815ED-7D7D-44C8-87AE-9B0F7F5F88A6}"
          SQLTask:SqlStatementSource="-- DIM_COUNTRY&#xA;CREATE TABLE dbo.DIM_COUNTRY&#xA;(&#xA;    country_key INT IDENTITY(1,1) NOT NULL,&#xA;    country_name VARCHAR(100) NOT NULL,&#xA;    CONSTRAINT PK_DIM_COUNTRY PRIMARY KEY (country_key)&#xA;);&#xA;&#xA;-- DIM_DATE&#xA;CREATE TABLE dbo.DIM_DATE&#xA;(&#xA;    date_key INT NOT NULL,&#xA;    full_date DATE NOT NULL,&#xA;    year INT NOT NULL,&#xA;    quarter INT NOT NULL,&#xA;    month INT NOT NULL,&#xA;    week_of_year INT NOT NULL,&#xA;    day INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_DATE PRIMARY KEY (date_key)&#xA;);&#xA;&#xA;-- DIM_TIME&#xA;CREATE TABLE dbo.DIM_TIME&#xA;(&#xA;    time_key INT NOT NULL,&#xA;    hour INT NOT NULL,&#xA;    minute INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_TIME PRIMARY KEY (time_key)&#xA;);&#xA;&#xA;-- DIM_WEATHER_CONDITION&#xA;CREATE TABLE dbo.DIM_WEATHER_CONDITION&#xA;(&#xA;    condition_key INT IDENTITY(1,1) NOT NULL,&#xA;    condition_text VARCHAR(100) NOT NULL,&#xA;    CONSTRAINT PK_DIM_WEATHER_CONDITION PRIMARY KEY (condition_key)&#xA;);&#xA;&#xA;-- DIM_WIND_DIRECTION&#xA;CREATE TABLE dbo.DIM_WIND_DIRECTION&#xA;(&#xA;    wind_direction_key INT IDENTITY(1,1) NOT NULL,&#xA;    wind_direction VARCHAR(50) NOT NULL,&#xA;    CONSTRAINT PK_DIM_WIND_DIRECTION PRIMARY KEY (wind_direction_key)&#xA;);&#xA;&#xA;-- DIM_MOON_PHASE&#xA;CREATE TABLE dbo.DIM_MOON_PHASE&#xA;(&#xA;    moon_phase_key INT IDENTITY(1,1) NOT NULL,&#xA;    moon_phase VARCHAR(50) NOT NULL,&#xA;    CONSTRAINT PK_DIM_MOON_PHASE PRIMARY KEY (moon_phase_key)&#xA;);&#xA;&#xA;-- DIM_LOCATION&#xA;CREATE TABLE dbo.DIM_LOCATION&#xA;(&#xA;    location_key INT IDENTITY(1,1) NOT NULL,&#xA;    location_name VARCHAR(150) NOT NULL,&#xA;    latitude FLOAT NULL,&#xA;    longitude FLOAT NULL,&#xA;    timezone VARCHAR(100) NULL,&#xA;    country_key INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_LOCATION PRIMARY KEY (location_key),&#xA;    CONSTRAINT FK_DIM_LOCATION_COUNTRY&#xA;        FOREIGN KEY (country_key)&#xA;        REFERENCES dbo.DIM_COUNTRY(country_key)&#xA;);&#xA;&#xA;-- DIM_ASTRONOMY&#xA;CREATE TABLE dbo.DIM_ASTRONOMY&#xA;(&#xA;    astronomy_key INT IDENTITY(1,1) NOT NULL,&#xA;    sunrise VARCHAR(20) NULL,&#xA;    sunset VARCHAR(20) NULL,&#xA;    moonrise VARCHAR(20) NULL,&#xA;    moonset VARCHAR(20) NULL,&#xA;    moon_phase_key INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_ASTRONOMY PRIMARY KEY (astronomy_key),&#xA;    CONSTRAINT FK_DIM_ASTRONOMY_MOON_PHASE&#xA;        FOREIGN KEY (moon_phase_key)&#xA;        REFERENCES dbo.DIM_MOON_PHASE(moon_phase_key)&#xA;);&#xA;&#xA;-- FACT_WEATHER&#xA;CREATE TABLE dbo.FACT_WEATHER&#xA;(&#xA;    weather_key BIGINT IDENTITY(1,1) NOT NULL,&#xA;    date_key INT NOT NULL,&#xA;    time_key INT NOT NULL,&#xA;    location_key INT NOT NULL,&#xA;    condition_key INT NOT NULL,&#xA;    wind_direction_key INT NOT NULL,&#xA;    astronomy_key INT NOT NULL,&#xA;    temperature_celsius FLOAT NULL,&#xA;    wind_kph FLOAT NULL,&#xA;    wind_degree INT NULL,&#xA;    pressure_mb FLOAT NULL,&#xA;    precip_mm FLOAT NULL,&#xA;    humidity INT NULL,&#xA;    cloud INT NULL,&#xA;    feels_like_celsius FLOAT NULL,&#xA;    visibility_km FLOAT NULL,&#xA;    uv_index FLOAT NULL,&#xA;    gust_kph FLOAT NULL,&#xA;    air_quality_ozone FLOAT NULL,&#xA;    air_quality_pm25 FLOAT NULL,&#xA;    air_quality_pm10 FLOAT NULL,&#xA;    moon_illumination INT NULL,&#xA;    CONSTRAINT PK_FACT_WEATHER PRIMARY KEY (weather_key),&#xA;    CONSTRAINT FK_FACT_WEATHER_DATE&#xA;        FOREIGN KEY (date_key)&#xA;        REFERENCES dbo.DIM_DATE(date_key),&#xA;    CONSTRAINT FK_FACT_WEATHER_TIME&#xA;        FOREIGN KEY (time_key)&#xA;        REFERENCES dbo.DIM_TIME(time_key),&#xA;    CONSTRAINT FK_FACT_WEATHER_LOCATION&#xA;        FOREIGN KEY (location_key)&#xA;        REFERENCES dbo.DIM_LOCATION(location_key),&#xA;    CONSTRAINT FK_FACT_WEATHER_CONDITION&#xA;        FOREIGN KEY (condition_key)&#xA;        REFERENCES dbo.DIM_WEATHER_CONDITION(condition_key),&#xA;    CONSTRAINT FK_FACT_WEATHER_WIND_DIRECTION&#xA;        FOREIGN KEY (wind_direction_key)&#xA;        REFERENCES dbo.DIM_WIND_DIRECTION(wind_direction_key),&#xA;    CONSTRAINT FK_FACT_WEATHER_ASTRONOMY&#xA;        FOREIGN KEY (astronomy_key)&#xA;        REFERENCES dbo.DIM_ASTRONOMY(astronomy_key)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

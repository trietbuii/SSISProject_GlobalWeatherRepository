      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E0D815ED-7D7D-44C8-87AE-9B0F7F5F88A6}"
          SQLTask:SqlStatementSource="-- DIM_COUNTRY&#xA;CREATE TABLE dbo.DIM_COUNTRY&#xA;(&#xA;    country_id INT IDENTITY(1,1) NOT NULL,&#xA;    country_name VARCHAR(100) NOT NULL,&#xA;    CONSTRAINT PK_DIM_COUNTRY PRIMARY KEY (country_id)&#xA;);&#xA;&#xA;-- DIM_DATE&#xA;CREATE TABLE dbo.DIM_DATE&#xA;(&#xA;    date_id INT NOT NULL,&#xA;    full_date DATE NOT NULL,&#xA;    year INT NOT NULL,&#xA;    quarter INT NOT NULL,&#xA;    month INT NOT NULL,&#xA;    week_of_year INT NOT NULL,&#xA;    day INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_DATE PRIMARY KEY (date_id)&#xA;);&#xA;&#xA;-- DIM_TIME&#xA;CREATE TABLE dbo.DIM_TIME&#xA;(&#xA;    time_id INT NOT NULL,&#xA;    hour INT NOT NULL,&#xA;    minute INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_TIME PRIMARY KEY (time_id)&#xA;);&#xA;&#xA;-- DIM_WEATHER_CONDITION&#xA;CREATE TABLE dbo.DIM_WEATHER_CONDITION&#xA;(&#xA;    condition_id INT IDENTITY(1,1) NOT NULL,&#xA;    condition_text VARCHAR(100) NOT NULL,&#xA;    CONSTRAINT PK_DIM_WEATHER_CONDITION PRIMARY KEY (condition_id)&#xA;);&#xA;&#xA;-- DIM_WIND_DIRECTION&#xA;CREATE TABLE dbo.DIM_WIND_DIRECTION&#xA;(&#xA;    wind_direction_id INT IDENTITY(1,1) NOT NULL,&#xA;    wind_direction VARCHAR(50) NOT NULL,&#xA;    CONSTRAINT PK_DIM_WIND_DIRECTION PRIMARY KEY (wind_direction_id)&#xA;);&#xA;&#xA;-- DIM_MOON_PHASE&#xA;CREATE TABLE dbo.DIM_MOON_PHASE&#xA;(&#xA;    moon_phase_id INT IDENTITY(1,1) NOT NULL,&#xA;    moon_phase VARCHAR(50) NOT NULL,&#xA;    CONSTRAINT PK_DIM_MOON_PHASE PRIMARY KEY (moon_phase_id)&#xA;);&#xA;&#xA;-- DIM_LOCATION&#xA;CREATE TABLE dbo.DIM_LOCATION&#xA;(&#xA;    location_id INT IDENTITY(1,1) NOT NULL,&#xA;    location_name VARCHAR(150) NOT NULL,&#xA;    latitude FLOAT NULL,&#xA;    longitude FLOAT NULL,&#xA;    timezone VARCHAR(100) NULL,&#xA;    country_id INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_LOCATION PRIMARY KEY (location_id),&#xA;    CONSTRAINT FK_DIM_LOCATION_COUNTRY&#xA;        FOREIGN KEY (country_id)&#xA;        REFERENCES dbo.DIM_COUNTRY(country_id)&#xA;);&#xA;&#xA;-- DIM_ASTRONOMY&#xA;CREATE TABLE dbo.DIM_ASTRONOMY&#xA;(&#xA;    astronomy_id INT IDENTITY(1,1) NOT NULL,&#xA;    sunrise VARCHAR(20) NULL,&#xA;    sunset VARCHAR(20) NULL,&#xA;    moonrise VARCHAR(20) NULL,&#xA;    moonset VARCHAR(20) NULL,&#xA;    moon_phase_id INT NOT NULL,&#xA;    CONSTRAINT PK_DIM_ASTRONOMY PRIMARY KEY (astronomy_id),&#xA;    CONSTRAINT FK_DIM_ASTRONOMY_MOON_PHASE&#xA;        FOREIGN KEY (moon_phase_id)&#xA;        REFERENCES dbo.DIM_MOON_PHASE(moon_phase_id)&#xA;);&#xA;&#xA;-- FACT_WEATHER&#xA;CREATE TABLE dbo.FACT_WEATHER&#xA;(&#xA;    weather_id BIGINT IDENTITY(1,1) NOT NULL,&#xA;    date_id INT NOT NULL,&#xA;    time_id INT NOT NULL,&#xA;    location_id INT NOT NULL,&#xA;    condition_id INT NOT NULL,&#xA;    wind_direction_id INT NOT NULL,&#xA;    astronomy_id INT NOT NULL,&#xA;    temperature_celsius FLOAT NULL,&#xA;    wind_kph FLOAT NULL,&#xA;    wind_degree INT NULL,&#xA;    pressure_mb FLOAT NULL,&#xA;    precip_mm FLOAT NULL,&#xA;    humidity INT NULL,&#xA;    cloud INT NULL,&#xA;    feels_like_celsius FLOAT NULL,&#xA;    visibility_km FLOAT NULL,&#xA;    uv_index FLOAT NULL,&#xA;    gust_kph FLOAT NULL,&#xA;    air_quality_ozone FLOAT NULL,&#xA;    air_quality_pm25 FLOAT NULL,&#xA;    air_quality_pm10 FLOAT NULL,&#xA;    moon_illumination INT NULL,&#xA;    CONSTRAINT PK_FACT_WEATHER PRIMARY KEY (weather_id),&#xA;    CONSTRAINT FK_FACT_WEATHER_DATE&#xA;        FOREIGN KEY (date_id)&#xA;        REFERENCES dbo.DIM_DATE(date_id),&#xA;    CONSTRAINT FK_FACT_WEATHER_TIME&#xA;        FOREIGN KEY (time_id)&#xA;        REFERENCES dbo.DIM_TIME(time_id),&#xA;    CONSTRAINT FK_FACT_WEATHER_LOCATION&#xA;        FOREIGN KEY (location_id)&#xA;        REFERENCES dbo.DIM_LOCATION(location_id),&#xA;    CONSTRAINT FK_FACT_WEATHER_CONDITION&#xA;        FOREIGN KEY (condition_id)&#xA;        REFERENCES dbo.DIM_WEATHER_CONDITION(condition_id),&#xA;    CONSTRAINT FK_FACT_WEATHER_WIND_DIRECTION&#xA;        FOREIGN KEY (wind_direction_id)&#xA;        REFERENCES dbo.DIM_WIND_DIRECTION(wind_direction_id),&#xA;    CONSTRAINT FK_FACT_WEATHER_ASTRONOMY&#xA;        FOREIGN KEY (astronomy_id)&#xA;        REFERENCES dbo.DIM_ASTRONOMY(astronomy_id)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
